# =========================================================
# FITCHECK — PERSONAL FASHION ANALYZER & DIGITAL WARDROBE
# Environment Variables Configuration
# =========================================================

# 1. Supabase Configuration (Optional - Hybrid Persistence Fallback Enabled)
# Create a project at https://supabase.com and run supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# NOTE: Never expose SUPABASE_SERVICE_ROLE_KEY on the frontend!
# Row Level Security (RLS) handles anonymous user isolation via X-Anonymous-User-Id header or anon_user_id column.

# 2. AI Vision API Configuration (Optional - For Server-Side Outfit Vision Analysis)
# Supports Google Gemini Vision API or OpenAI Vision API
# If not configured, FITCHECK automatically runs its Canvas Pixel Color Extraction + Rule-Based Sartorial Engine
# and transparently labels the analysis mode.
GEMINI_API_KEY=
OPENAI_API_KEY=

